// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Hand {
  LEFT
  RIGHT
}

enum Backhand {
  TWOHANDED
  ONEHANDED
}

enum TournamentType {
  GS
  ATPM1000
  ATP500
  ATP250
  Finals
  NextGen
  DavisCup
  LaverCup
  TeamCup
  Olympics
}

/// F to R128 are knockout rounds. RR = round robin / group stage, PO = knockout stage of a
/// team event, TIE = Davis Cup / Laver Cup rubber, BR = bronze-medal match.
enum Round {
  F
  SF
  QF
  R16
  R32
  R64
  R128
  RR
  PO
  TIE
  BR
}

enum MatchStatus {
  COMPLETED
  RETIRED
  WALKOVER
  AWARDED
}

/// Created and named by the seed loader from the match data (tennisdata.app).
/// The bio fields are optional extras entered by an admin.
model Player {
  id         String    @id @default(uuid())
  /// The source's player ID, stable across seasons.
  sourceId   String    @unique
  /// Abbreviated, as the source gives it ("Dimitrov G."). Updated by every load.
  name       String
  /// Entered by an admin ("Grigor Dimitrov"). Shown instead of `name` when set.
  fullName   String?
  nickName   String?
  hand       Hand?
  backHand   Backhand?
  country    String?
  birthPlace String?
  turnedPro  String?
  age        String?
  profile    String?
  image      String?

  wins   Match[] @relation("MatchWinner")
  losses Match[] @relation("MatchLoser")

  @@index([name])
}

/// One event across seasons, e.g. "roland-garros". Created by the seed loader.
model Tournament {
  /// Slug from the event name, e.g. "roland-garros".
  id             String         @id
  name           String
  /// Level in the most recent season loaded.
  tournamentType TournamentType
  /// Surface in the most recent season loaded. Null for the Davis Cup.
  surface        String?
  indoor         Boolean        @default(false)
  drawSize       Int?
  description    String?
  image          String?

  matches Match[]
}

model Match {
  id               Int         @id @default(autoincrement())
  /// The source's match ID.
  sourceMatchId    String      @unique
  season           Int
  playedAt         DateTime
  tournamentId     String
  tournament       Tournament  @relation(fields: [tournamentId], references: [id])
  /// Extra detail from the source, e.g. the host city or the Davis Cup group.
  tournamentDetail String?
  round            Round
  /// "Hard", "Clay" or "Grass". Null for Davis Cup ties.
  surface          String?
  indoor           Boolean     @default(false)
  status           MatchStatus
  bestOf           Int
  /// Winner's games first, e.g. "7-6 3-6 6-4", "6-3 2-0 RET" or "W/O".
  score            String

  winnerId String
  winner   Player @relation("MatchWinner", fields: [winnerId], references: [id])
  loserId  String
  loser    Player @relation("MatchLoser", fields: [loserId], references: [id])

  winnerRank          Int?
  loserRank           Int?
  winnerRankingPoints Int?
  loserRankingPoints  Int?
  winnerSets          Int?
  loserSets           Int?

  winnerAces                Int?
  loserAces                 Int?
  winnerDoubleFaults        Int?
  loserDoubleFaults         Int?
  /// Percentages are whole numbers from 0 to 100.
  winnerServicePointsWonPct Int?
  loserServicePointsWonPct  Int?
  winnerReturnPointsWonPct  Int?
  loserReturnPointsWonPct   Int?
  winnerBreakPointsWonPct   Int?
  loserBreakPointsWonPct    Int?
  winnerBreakPointsSavedPct Int?
  loserBreakPointsSavedPct  Int?

  @@index([winnerId, playedAt])
  @@index([loserId, playedAt])
  @@index([tournamentId, season])
  @@index([season])
  @@index([playedAt])
}
